'''
Необходимо выполнить аппроксимацию (восстановление) заданной функции на интервале [-4, 6] моделью вида:
a(x)=w0+w1⋅x+w2⋅x^2+w3⋅x^3

Вектор параметров w следует искать с помощью алгоритма стохастического градиентного спуска (SGD) с оптимизатором импульсов Нестерова:
v=γ⋅v+(1−γ)⋅η⋅∂Qk(w−γ⋅v)/∂w
wn=wn−1 − v,
где k - случайно выбранный образ из обучающей выборки; 
Qk(w) - усеченный эмпирический риск по мини-батчу K,
квадратичная функция потерь

Производная усеченного показателя качества может быть записана в следующем векторно-матричном виде:
∂Qk(w−γ⋅v)/∂w=2/K sum(((w−γ⋅v)T⋅xi−yi)⋅xiT), i=[k, k+K-1]
'''



import numpy as np

# исходная функция, которую нужно аппроксимировать моделью a(x)
def func(x):
    return -0.7 * x - 0.2 * x ** 2 + 0.05 * x ** 3 - 0.2 * np.cos(3 * x) + 2

coord_x = np.arange(-4.0, 6.0, 0.1) # значения по оси абсцисс [-4; 6] с шагом 0.1
coord_y = func(coord_x) # значения функции по оси ординат

sz = len(coord_x)	# количество значений функций (точек)
eta = np.array([0.1, 0.01, 0.001, 0.0001]) # шаг обучения для каждого параметра w0, w1, w2, w3
w = np.array([0., 0., 0., 0.]) # начальные значения параметров модели
N = 500 # число итераций алгоритма SGD
lm = 0.02 # значение параметра лямбда для вычисления скользящего экспоненциального среднего
K = 20 # размер мини-батча (величина K = 20)
gamma = 0.8 # коэффициент гамма для вычисления импульсов Нестерова
v = np.zeros(len(w))  # начальное значение [0, 0, 0, 0]
X = np.array([[1, x, x**2, x**3] for x in coord_x])
Qe = np.mean((X @ w - coord_y) ** 2) # начальное значение среднего эмпирического риска
np.random.seed(0) # генерация одинаковых последовательностей псевдослучайных чисел

for _ in range(N):
    k = np.random.randint(0, sz-K-1)
    Qe = lm * np.mean([(np.dot(w, X[i]) - coord_y[i]) ** 2 for i in range(k, k+K)]) + (1-lm) * Qe
    v = gamma * v + (1-gamma) * eta * 2 * np.mean([((w-gamma * v) @ X[i] - coord_y[i]) * X[i] for i in range(k, k+K)], axis=0)
    w = w - v

Q = np.mean((X @ w - coord_y) ** 2)
