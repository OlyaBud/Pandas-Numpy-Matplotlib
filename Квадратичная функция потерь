'''
В программе ниже сформирована выборка x, y из случайных значений в соответствии с формулой: yi = w0 + w1 * xi 
Значения yi прогнозируются с помощью следующей параметрической модели: a(x,w) = w0 + w1 * x
с параметрами w0=0,5;w1=−0,3.

Используя квадратическую функцию потерь, вычислите в программе значение среднего эмпирического риска Q(a,X) 
'''



import numpy as np

np.random.seed(0)
x = np.arange(-1.0, 1.0, 0.1)

size_train = len(x)
w = [0.5, -0.3]
model_a = lambda m_x, m_w: (m_w[1] * m_x + m_w[0])
loss = lambda ax, y: (ax - y) ** 2

y = model_a(x, w) + np.random.normal(0, 0.1, len(x)) # целевые значения
Q = 1/size_train * sum(loss(model_a(x, w), y))
