'''
В задании на исследование пересечений графиков функций с помощью matplotlib мы изучали пару интересных функций:

f(x)=np.sin(x/5) * np.exp(x/10) + 5 * np.exp(-x/2)
и
g(x)=1 - x ** 3 + x ** 5 

Теперь у нас есть более удобный инструмент, позволяющий работать с графиками интерактивно, менять масштаб, двигать, не перестраивая результат ячейки, поэтому имеет смысл к ним вернуться.

Не все заметили (и это было не страшно), что эти 2 функции имеют бесконечно много точек пересечений.

В этом задании необходимо построить 1 фигуру, содержащую несколько изображений. В результате должна получиться 1 фигура следующего вида:
Main  Detail1
      Detail2
      Detail3
      Detail4
LOG

Во всех областях должны быть показаны по 2 графика (f(x) и g(x)).

Отличаться будет масштаб осей и интервал аргументов и функций, которые выводятся.

MAIN - основное изображение - линейный масштаб, x в интервале от 0 до 500

LOG - логарифмический масштаб вдоль оси Y. X в интервале от 0 до 500

Detail (1-4) - 4 графика с линейным масштабом и таким интервалом x и y, чтобы было видно хотя бы по 1 точке пересечения

Таким образом, мы эмулируем ситуацию одного большого окна для детального просмотра, одного вспомогательного окна с изменённым масштабом и нескольких окон, акцентирующих внимание на важных деталях. При этом, если вы используете достаточно много точек в основном масштабе, то в интерактивном режиме вы можете приблизить какой-то интервал, соответствующий, например, окнам detail и убедиться, что графики действительно пересекаются.

Убедитесь, что на всех фигурах кривые, соответствующие одной функции выводятся одним цветом.

Подписи выводить не обязательно.

Рекомендуется изменить отступ от краёв фигуры и, возможно, размер самой фигуры.
'''



import numpy as np
import plotly.graph_objects as go
from plotly.subplots import make_subplots

def f(x):
    return np.sin(x/5) * np.exp(x/10) + 5 * np.exp(-x/2)

def g(x):
    return 1 - x ** 3 + x ** 5

# Общие настройки

fig = make_subplots(rows=5, cols=2,
                    specs=[[{"rowspan": 4}, {}],
                           [None, {}],
                           [None, {}],
                           [None, {}],
                           [{}, None]],
                    subplot_titles = ["Главный график", "График пересечения в окрестности [1.31, 1.35]",
                                               'График многочисленных пересечений на [400, 500]',
                                               'График пересечения в окрестности [408, 409]',
                                               'График пересечения в окрестности [424, 424.2]',
                                               'График на лог.шкале y', ''])
fig.update_xaxes(zeroline=True,
                 zerolinewidth=2,
                 zerolinecolor='grey',
                 title='х')
fig.update_yaxes(zeroline=True,
                 zerolinewidth=2,
                 zerolinecolor='grey',
                 title='y')
x = np.linspace(0, 500, 100000)


fig.update_layout(title="Исследование двух сложных функций на отрезке [0, 500]",
                  xaxis_title="x",
                  yaxis_title="y",
                  showlegend=False,
                  hovermode="x",
                  margin=dict(l=50, r=50, t=50, b=50),
                  height=700,
                  width=1000,
                  font=dict(size=10),
                  title_font_size=20)
fig.update_traces(hovertemplate="x: %{x}<br>y: %{y}")

matrix = [(1,1),(1,2),(2,2),(3,2),(4,2),(5,1)]
for el in matrix:
    fig.add_trace(go.Scatter(x=x, y=f(x),
                             name='f(x) = np.sin(x/5) * np.exp(x/10) + 5 * np.exp(-x/2)',
                             mode='lines',
                             line=dict(color='red')), *el)
    fig.add_trace(go.Scatter(x=x, y=g(x),
                             name='g(x) = 1 - x ** 3 + x ** 5',
                             mode='lines',
                             line=dict(color='blue')), *el)
# Основной график
# Нижний график
fig.update_yaxes(row=5, col=1,
                 type="log")
# Детальный график 1
fig.update_xaxes(range = [1.31, 1.35],
                 row=1, col=2)
fig.update_yaxes(range = [2, 3.5],
                 row=1, col=2)
# Детальный график 2
fig.update_xaxes(range = [400, 500],
                 row=2, col=2)
fig.update_yaxes(range = [-10**15, 10**15],
                 row=2, col=2)
# Детальный график 3
fig.update_xaxes(range = [408, 409],
                 row=3, col=2)
fig.update_yaxes(range = [-10**15, 10**15],
                 row=3, col=2)
# Детальный график 4
fig.update_xaxes(range = [424, 424.2],
                 row=4, col=2)
fig.update_yaxes(range = [-10**15, 10**15],
                 row=4, col=2)

fig.show()
