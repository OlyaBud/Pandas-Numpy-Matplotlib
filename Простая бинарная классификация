'''
Продолжите программу, в которой задана тестовая выборка в виде набора образов с двумя признаками и соответствующими метками двух классов:

x_test = np.array([(-5, 2), (-4, 6), (3, 2), (3, -3), (5, 5), (5, 2), (-1, 3)])
y_test = np.array([1, 1, 1, -1, -1, -1, -1])

                  
Также в программе определен вектор параметров w модели a(x), задающие ориентацию разделяющей линии:
w = np.array([-8/3, -2/3, 1])
               
Необходимо вычислить показатель качества Q по формуле: суммарное [Mi < 0]
'''



import numpy as np

x_test = np.array([(-5, 2), (-4, 6), (3, 2), (3, -3), (5, 5), (5, 2), (-1, 3)])
y_test = np.array([1, 1, 1, -1, -1, -1, -1])
w = np.array([-8/3, -2/3, 1])
x = np.array([[1, *c] for c in x_test])
margin = x @ w * y_test
print(sum(margin < 0))
