import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd
from datetime import datetime
import numpy as np

df = pd.read_csv(r'E:\\new/dataset_file_storage.csv', sep=';')
pd.set_option('display.max_columns', None)
df['datetime'] = pd.to_datetime(df['uploadServerUnixTime'], unit='s')
df = df[df['datetime'] < pd.to_datetime('2020-03-01')].sort_values('datetime')

# Задача 1.1
df['date'] = df['datetime'].dt.date
df1 = df.groupby('date')['FileSize'].sum()

fig = plt.figure(figsize=(16,8))
pic = sns.barplot(df1.cumsum())
pic.set_yscale('log')
pic.set_title('Распределение общего объема файлов по дням (факт, лог.шкала)')
pic.set_xlabel('День')
pic.set_ylabel('Общий объем файлов (лог.шкала)')
pic.tick_params(axis='x', labelrotation=80, labelsize=6)
fig.savefig(r'E:\\new\\1.1.png')
fig.show()

# Задача 1.2 и 1.3
df2 = df.groupby(df['datetime'].dt.strftime('%Y-%m'))['FileSize'].sum().cumsum()
for i in range(3, 13):
    new_month = (datetime.strptime(df2.index.max(), '%Y-%m') + pd.Timedelta('32 day')).strftime('%Y-%m')
    df2.loc[f'{new_month}'] = df2.max() + df2.diff().iloc[(i-3) % 3 + 2]

print(f'Прогнозируемое значение на конец 2020 года - {df2.iloc[-1]:.0e}')

fig = plt.figure(figsize=(16,8))
pic = sns.barplot(df2)
pic.set_yscale('log')
pic.set_title('Распределение общего объема файлов по месяцам (лог.шкала)')
pic.set_xlabel('Месяц')
pic.set_ylabel('Общий объем файлов (лог.шкала)')
pic.axvline(x='2020-03', color='red', linestyle='dashed', linewidth=2)
pic.text(x='2020-04', y= 8 * 10**10, s='Прогноз', color='red', size=12)
pic.text(x='2019-11', y= 8 * 10**10, s='Факт', color='blue', size=12)
pic.text(x='2019-10', y= 10**9, s='Не учитывается в прогнозе', color='green', rotation=90)
pic.text(x=14 - 0.3, y= 9 * 10**10, s=f'{df2.iloc[-1]:.0e}', color='green', size=12)
pic.tick_params(axis='x', labelrotation=45, labelsize=10)
plt.savefig(r'E:\\new\\1.3.png')
plt.show()

# Задача 2

fig, axes = plt.subplots(1, 2, figsize=(16, 8))
sns.countplot(x=df['datetime'].dt.hour, ax=axes[0])
axes[0].set_title('Распределение общего объема файлов по часам')
axes[0].set_xlabel('Час')
axes[0].set_ylabel('Количество файлов')

sns.countplot(x=df['datetime'].dt.day_of_week, ax=axes[1])
axes[1].set_xticks(np.arange(0, 6))
axes[1].set_xticklabels(['Понедельник','Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота'])
axes[1].set_title('Распределение общего объема файлов по дням недели')
axes[1].set_xlabel('День недели')
axes[1].set_ylabel('Количество файлов')
plt.savefig(r'E:\\new\\2.png')
plt.show()

print('Самые загруженные часы: с 7 до 15 с перерывами в районе 10 и 13 часов. Загрузка файлов вообще не ведется в вечерне-ночное время с 22 до 3 включительно.')
print('По дням недели: самый загруженный день - понедельник, наименее - суббота. Загрузка вообще не ведется в воскресение')

# Задача 3
df3 = df.groupby('ProjectID')['TypeDocs'].value_counts().reset_index()
fig, axes = plt.subplots(1, 2, figsize=(16, 8))
types = sorted(df3['TypeDocs'].unique())
palette_colors = sns.color_palette('deep', len(types))
fixed_palette = dict(zip(types, palette_colors))

sns.countplot(df, x='TypeDocs', order=types, hue='TypeDocs', palette=fixed_palette, ax=axes[0])
axes[0].tick_params(axis='x', labelrotation=30, labelsize=8)
axes[0].set_title('Распределение общего количества документов в зависимости от вида файлов')
axes[0].set_xlabel('Виды документов')
axes[0].set_ylabel('Количество файлов')

sns.boxplot(df3, x='TypeDocs', y='count', hue='TypeDocs', palette=fixed_palette, order = types, ax=axes[1])
axes[1].set_yscale('log')
axes[1].set_title('Распределение среднего количества документов в зависимости от вида файлов')
axes[1].set_xlabel('Виды документов')
axes[1].set_ylabel('Количество файлов')
axes[1].tick_params(axis='x', labelrotation=30, labelsize=8)
plt.tight_layout()
